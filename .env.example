# ─────────────────────────────────────────────────────────────────────────────
# JARVIS SOCIETY — environment variables
# Copy this file to `.env` (same folder) and fill in the values from your
# Supabase project. Do NOT commit `.env` — it holds secret keys.
#
# Where to find each value:
#   Supabase Dashboard → Project Settings → API
#     - Project URL              -> SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
#     - anon `public` key        -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#     - service_role secret key  -> SUPABASE_SERVICE_ROLE_KEY
# ─────────────────────────────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
# Used by the live app / APIs.
SUPABASE_URL=

# Same value as SUPABASE_URL. The `NEXT_PUBLIC_` prefix means Next.js inlines
# it into the browser bundle — this one powers the OAuth login popup.
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe to expose in the browser; used by the client
# Supabase instance for the Google OAuth sign-in flow. RLS keeps it read-only
# on protected tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key — SERVER ONLY. Never expose it, never put it in a
# `NEXT_PUBLIC_` var. Bypasses RLS and is used by every admin API route
# (team/projects CRUD, image uploads, admin verification).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — your Supabase database password. Only needed if you want to run
# `psql` directly against the DB. Not read by the app itself.
# SUPABASE_PASSWORD=